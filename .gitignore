!wp-content/themes/lamagicieuse/

# ===== Plugins tiers (garder uniquement magicieuse-headless-api) =====
wp-content/plugins/*
!wp-content/plugins/magicieuse-headless-api/

# ===== mu-plugins (auto-généré par Elementor) =====
wp-content/mu-plugins/

# ===== Base de données =====
BDD/

